{
  "name": "pocketly",
  "private": true,
  "description": "A monorepo for small, lightweight web tools.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11 <12",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/avro-viewer",
    "apps/csv-gantt-viewer",
    "apps/markdown-editor",
    "apps/restructuredtext-editor"
  ],
  "devDependencies": {
    "serve-handler": "6.1.7"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:list": "npm run test:list --workspaces --if-present",
    "test:browser:install": "npm run test:browser:install --workspaces --if-present"
  }
}
